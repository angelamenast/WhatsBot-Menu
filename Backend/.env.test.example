# Proyecto Supabase de PRUEBAS (nunca el compartido del equipo).
# Copia este archivo a .env.test y completa los valores.
# La suite aborta si SUPABASE_TEST_URL es igual a SUPABASE_URL de .env.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Wompi SANDBOX (nunca llaves de producción). Si faltan, las pruebas de Wompi se saltan.
# La suite aborta si la URL no contiene "sandbox", si pub/prv no contienen "_test_"
# o si el secret de eventos no empieza por "test_".
WOMPI_TEST_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_TEST_PUBLIC_KEY=
WOMPI_TEST_PRIVATE_KEY=
WOMPI_TEST_EVENTS_SECRET=
