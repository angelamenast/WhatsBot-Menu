PORT=3000
FRONTEND_URL=http://localhost:4321
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<la service_role key>
# WhatsApp (módulo whatsapp). MESSAGING_PROVIDER y PROVISIONING_PROVIDER: fake | meta
MESSAGING_PROVIDER=fake
FAKE_MESSAGING_FORCE_FAIL=false
PROVISIONING_PROVIDER=fake
FAKE_PROVISIONING_FORCE_FAIL=false
# Solo con MESSAGING_PROVIDER=meta o PROVISIONING_PROVIDER=meta (las tres primeras son obligatorias y el
# backend no arranca sin ellas). Ver docs/whatsapp-meta.md. No pongas valores reales en este archivo.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# PLAN_STATUS_PROVIDER: fake | subscriptions
# Con "subscriptions" el estado sale de la suscripción real (RF-25): plan vencido Y negocio SIN plan no reciben respuesta.
PLAN_STATUS_PROVIDER=fake
PLAN_STATUS_FORCE_INACTIVE=false

# whatsapp -> agent: fake | agent
AGENT_DISPATCH_PROVIDER=agent

# Módulo agent (el LLM y la cuota son fake por defecto; el catálogo y los pedidos usan la base de datos)
# LLM_PROVIDER: fake | openai | gemini (openai aún no implementado)
LLM_PROVIDER=fake
# OpenAI (solo con LLM_PROVIDER=openai). OPENAI_MODEL no tiene valor por defecto: hay que elegirlo.
OPENAI_API_KEY=
OPENAI_MODEL=
# El timeout debe quedar POR DEBAJO del que Twilio aplica al webhook: la respuesta del LLM es síncrona y sin reintentos.
OPENAI_TIMEOUT_MS=10000
OPENAI_MAX_OUTPUT_TOKENS=500
# OPENAI_TEMPERATURE: opcional (0 a 2). Si no se define, no se envía el parámetro.
# OPENAI_TEMPERATURE=
# Gemini (solo con LLM_PROVIDER=gemini). La clave es de Google AI Studio; va SOLO en tu .env local, nunca en el código ni en commits.
GEMINI_API_KEY=
# Modelo y nivel de razonamiento (minimal | low | medium | high). Con low se busca responder en menos de 5 s.
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional. Ante 503 o 429: se reintenta el principal una vez (1 s) y luego se usa este modelo. Vacío = sin respaldo.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=low
# Presupuesto TOTAL por mensaje en ms (reintento y respaldo incluidos; cada intento recibe lo que reste).
# El tope de tokens de salida incluye los tokens de razonamiento.
GEMINI_TIMEOUT_MS=5000
GEMINI_MAX_OUTPUT_TOKENS=1024
# USAGE_QUOTA_PROVIDER: fake | supabase (RNF-08; fake = siempre hay cuota. Con supabase se aplica planes.limite_tokens por periodo;
# requiere aplicar la migración 20261018140000_create_token_quota_functions.sql)
USAGE_QUOTA_PROVIDER=fake
# ORDER_PROVIDER: fake | orders (orders crea el pedido real cuando el agente lo propone; fake lo simula)
ORDER_PROVIDER=orders
# CATALOG_PROVIDER: supabase | fake (default: supabase; lee catalogo_productos. "fake" devuelve 3 productos de ejemplo a cualquier negocio: solo para desarrollo)
CATALOG_PROVIDER=supabase
