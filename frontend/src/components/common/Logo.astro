---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<a href="/" class={`flex items-center gap-3 group ${className}`}>
  <div
    class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-white shadow-sm transition-transform group-hover:scale-105"
  >
    <span class="material-symbols-outlined text-2xl fill">smart_toy</span>
  </div>
  <span class="text-2xl md:text-3xl font-bold text-primary tracking-tight">
    Tremia
  </span>
</a>
