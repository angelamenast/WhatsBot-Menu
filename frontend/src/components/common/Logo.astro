---
// Símbolo de Tremia (sin el nombre ni el eslogan). El nombre queda como texto accesible.
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "", size = 40 } = Astro.props;
---

<a href="/" class={`inline-flex items-center group ${className}`} aria-label="Tremia, ir al inicio">
  <img
    src="/logo.png"
    alt="Tremia"
    width={size}
    height={size}
    class="object-contain transition-transform group-hover:scale-105"
  />
</a>
