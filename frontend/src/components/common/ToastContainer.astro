---

---

<div
  id="toast-container"
  class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"
>
</div>

<script>
  // Función global accesible desde cualquier script del navegador
  (window as any).showToast = (
    message: string,
    type: "success" | "info" | "warning" = "success",
  ) => {
    const container = document.getElementById("toast-container");
    if (!container) return;

    const toast = document.createElement("div");
    const icons = {
      success: "check_circle",
      info: "info",
      warning: "warning",
    };

    const bgColors = {
      success: "bg-zinc-900 border-emerald-500/50 text-white",
      info: "bg-zinc-900 border-orange-500/50 text-white",
      warning: "bg-zinc-900 border-amber-500/50 text-white",
    };

    const iconColors = {
      success: "text-emerald-400",
      info: "text-orange-400",
      warning: "text-amber-400",
    };

    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border shadow-lg transition-all duration-300 opacity-0 translate-y-4 ${bgColors[type]}`;
    toast.innerHTML = `
      <span class="material-symbols-outlined text-[20px] ${iconColors[type]}">${icons[type]}</span>
      <span class="text-xs font-medium">${message}</span>
    `;

    container.appendChild(toast);

    // Animación de entrada
    requestAnimationFrame(() => {
      toast.classList.remove("opacity-0", "translate-y-4");
    });

    // Auto eliminar a los 3.5 segundos
    setTimeout(() => {
      toast.classList.add("opacity-0", "translate-y-2");
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  };
</script>
