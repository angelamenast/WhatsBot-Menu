---

---

<section class="py-24 bg-surface" id="pricing">
  <div class="max-w-7xl mx-auto px-gutter-mobile md:px-gutter-desktop">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-on-surface">
        Planes simples y transparentes
      </h2>
      <p class="text-lg text-on-surface-variant mt-4">
        Escala tu operación sin sorpresas a fin de mes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-start">
      <div
        class="bg-surface-container-lowest rounded-2xl p-8 border border-border-technical ambient-shadow flex flex-col h-full"
      >
        <div class="mb-6">
          <h3 class="text-xl font-bold text-on-surface">Gratis</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Para negocios que recién comienzan.
          </p>
        </div>
        <div class="mb-8">
          <span class="text-4xl font-bold text-on-surface">$0</span>
          <span class="text-sm text-on-surface-variant">/mes</span>
          <p class="text-xs text-on-surface-variant mt-1">
            Prueba gratis de 14 días
          </p>
        </div>
        <ul class="space-y-4 mb-8 flex-grow">
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant">1 Agente Bot</span>
          </li>
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Hasta 500 conversaciones/mes</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Tablero de gestión básico</span
            >
          </li>
        </ul>
        <button
          class="w-full bg-surface-container hover:bg-orange-light hover:text-secondary text-on-surface px-6 py-3 rounded-lg font-semibold transition-colors duration-300"
          >Empezar Gratis</button
        >
      </div>

      <div
        class="bg-surface-container-lowest rounded-2xl p-8 border-2 border-primary ambient-shadow-lg flex flex-col h-full relative transform md:-translate-y-4"
      >
        <div
          class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-primary text-on-primary px-4 py-1 rounded-full text-xs uppercase tracking-wider font-semibold shadow-sm"
        >
          Más Popular
        </div>
        <div class="mb-6">
          <h3 class="text-xl font-bold text-on-surface">Low Cost</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Para operaciones de ventas activas.
          </p>
        </div>
        <div class="mb-8">
          <span class="text-4xl font-bold text-on-surface">$29</span>
          <span class="text-sm text-on-surface-variant">/mes</span>
        </div>
        <ul class="space-y-4 mb-8 flex-grow">
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface font-semibold"
              >5 Agentes Bot con Personalidad</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Conversaciones ilimitadas</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Integración CRM & Pagos</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Analíticas avanzadas</span
            >
          </li>
        </ul>
        <button
          class="w-full bg-primary hover:bg-secondary text-on-primary px-6 py-3 rounded-lg font-semibold transition-colors duration-300 shadow-md"
          >Suscribirse Ahora</button
        >
      </div>

      <div
        class="bg-surface-container-lowest rounded-2xl p-8 border border-border-technical ambient-shadow flex flex-col h-full"
      >
        <div class="mb-6">
          <h3 class="text-xl font-bold text-on-surface">High Cost</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Soluciones a medida para corporaciones.
          </p>
        </div>
        <div class="mb-8 mt-[14px]">
          <span class="text-2xl font-bold text-on-surface">A Medida</span>
        </div>
        <ul class="space-y-4 mb-8 flex-grow mt-2">
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Agentes Bot ilimitados</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Modelos de IA dedicados</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="material-symbols-outlined text-primary text-[20px] mt-0.5"
              >check_circle</span
            ><span class="text-sm text-on-surface-variant"
              >Soporte técnico 24/7 SLA</span
            >
          </li>
        </ul>
        <button
          class="w-full bg-transparent border border-outline hover:border-primary text-on-surface hover:text-primary px-6 py-3 rounded-lg font-semibold hover:bg-orange-subtle transition-colors duration-300"
          >Contactar Ventas</button
        >
      </div>
    </div>
  </div>
</section>
