---

<section class="relative pt-24 pb-32 overflow-hidden">
  <div
    class="absolute top-0 right-0 -mr-[20%] -mt-[10%] w-[60%] h-[80%] rounded-full bg-orange-light/50 blur-3xl -z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 -ml-[10%] -mb-[10%] w-[40%] h-[60%] rounded-full bg-orange-subtle blur-3xl -z-10"
  >
  </div>

  <div
    class="max-w-7xl mx-auto px-gutter-mobile md:px-gutter-desktop grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop items-center"
  >
    <div class="lg:col-span-6 flex flex-col gap-unit-sm">
      <div
        class="inline-flex items-center gap-2 bg-orange-light/60 border border-primary/40 px-3 py-1 rounded-full w-fit mb-4"
      >
        <span class="material-symbols-outlined text-primary text-[18px]"
          >auto_awesome</span
        >
        <span
          class="text-xs text-primary uppercase tracking-wider font-semibold"
          >Nuevo: IA Conversacional 2.0</span
        >
      </div>
      <h1
        class="text-4xl lg:text-5xl font-bold text-on-surface text-balance leading-tight"
      >
        Convierte tu WhatsApp en un <span class="text-primary"
          >vendedor experto</span
        >.
      </h1>
      <p class="text-lg text-on-surface-variant mt-4 max-w-[480px]">
        Automatiza tus ventas, responde consultas al instante y gestiona pedidos
        24/7 sin perder el toque humano. Diseñado para operaciones de ventas
        profesionales.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-unit-sm mt-8">
        <button
          class="w-full sm:w-auto bg-primary hover:bg-secondary text-on-primary px-6 py-3 rounded-lg font-semibold transition-all duration-300 shadow-md"
          >Comenzar Prueba Gratis</button
        >
      </div>
      <div class="flex items-center gap-unit-xs mt-6 text-on-surface-variant">
        <span class="material-symbols-outlined fill text-[#F59E0B] text-[20px]"
          >star</span
        >
        <span class="material-symbols-outlined fill text-[#F59E0B] text-[20px]"
          >star</span
        >
        <span class="material-symbols-outlined fill text-[#F59E0B] text-[20px]"
          >star</span
        >
        <span class="material-symbols-outlined fill text-[#F59E0B] text-[20px]"
          >star</span
        >
        <span class="material-symbols-outlined fill text-[#F59E0B] text-[20px]"
          >star</span
        >
        <span class="text-sm ml-2 font-medium">5.0 de +500 negocios</span>
      </div>
    </div>

    <div class="lg:col-span-6 relative mt-12 lg:mt-0">
      <div
        class="relative w-full aspect-[4/3] rounded-xl overflow-hidden ambient-shadow-lg bg-surface-container-lowest border border-border-technical"
      >
        <div
          class="w-full h-full bg-cover bg-center"
          style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAdiuzf8t5nLb6BH7bTc8koa4m1ZIPkKWcE-EdYosyZlbwj6Qn3s09EgYoXT7jPLLFJeSk2kBv6l_thUvlXbLwnDNnTxeFIXZXpQbkWLinEKNV7vkBEHpO3wMoC32ogh9y3kGcOe67rt6w-ssQhNr6FEUUzTiSuU93qUCjmyHYb3Pv2aLEIIJ36T_NLb8i1baHq-ubVQV72ZqPpagworkRMU_lL3I2v-AEQSOesdpa4jiBHJxqPlOIs')"
        >
        </div>
      </div>
      <div
        class="absolute -bottom-6 -left-6 bg-surface-container-lowest p-4 rounded-xl ambient-shadow-lg border border-border-technical flex items-center gap-unit-sm animate-[bounce_4s_infinite]"
      >
        <div class="bg-orange-light p-2 rounded-lg">
          <span class="material-symbols-outlined text-primary">trending_up</span
          >
        </div>
        <div>
          <p class="text-xs text-on-surface-variant">Conversión Promedio</p>
          <p class="text-xl text-primary font-bold">+34%</p>
        </div>
      </div>
    </div>
  </div>
</section>
