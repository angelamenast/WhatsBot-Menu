---
interface Props {
  currentStep?: number;
}

const { currentStep = 1 } = Astro.props;
---

<div class="max-w-3xl mx-auto mb-space-3xl">
  <div class="flex items-center justify-between relative">
    <div
      class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-1 bg-surface-container-high rounded-full -z-0"
    >
      <div
        class={`h-full bg-primary-container rounded-full ${currentStep === 1 ? "w-1/2" : "w-full"} transition-all duration-500`}
      >
      </div>
    </div>

    <!-- Paso 1 -->
    <div
      class={`relative z-10 flex items-center gap-space-sm px-space-md py-space-xs rounded-full shadow-sm ${currentStep === 1 ? "bg-surface-container-lowest" : "bg-surface-container-low opacity-70"}`}
    >
      <div
        class={`w-7 h-7 rounded-full flex items-center justify-center font-label-md text-label-md ${currentStep === 1 ? "bg-primary-container text-on-primary" : "bg-surface-container-high text-on-surface-variant"}`}
      >
        1
      </div>
      <div class="flex flex-col">
        <span
          class={`font-label-md text-label-md font-bold ${currentStep === 1 ? "text-primary" : "text-on-surface-variant"}`}
          >Paso 1 de 2</span
        >
        <span
          class="font-label-sm text-label-sm text-on-surface-variant hidden sm:inline"
          >Selección y Detalles</span
        >
      </div>
    </div>

    <!-- Paso 2 -->
    <div
      class={`relative z-10 flex items-center gap-space-sm px-space-md py-space-xs rounded-full shadow-sm ${currentStep === 2 ? "bg-surface-container-lowest" : "bg-surface-container-low opacity-70"}`}
    >
      <div
        class={`w-7 h-7 rounded-full flex items-center justify-center font-label-md text-label-md ${currentStep === 2 ? "bg-primary-container text-on-primary" : "bg-surface-container-high text-on-surface-variant"}`}
      >
        2
      </div>
      <div class="flex flex-col">
        <span
          class={`font-label-md text-label-md font-bold ${currentStep === 2 ? "text-primary" : "text-on-surface-variant"}`}
          >Paso 2 de 2</span
        >
        <span
          class="font-label-sm text-label-sm text-on-surface-variant/70 hidden sm:inline"
          >Pago Seguro</span
        >
      </div>
    </div>
  </div>
</div>
