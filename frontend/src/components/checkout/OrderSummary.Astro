---

---

<div class="max-w-2xl mx-auto w-full">
  <div
    class="bg-surface-container-lowest rounded-xl p-space-xl shadow-lg border-2 border-primary-container/20"
  >
    <div
      class="flex items-center justify-between pb-space-md mb-space-md border-b border-surface-container-high"
    >
      <div class="flex items-center gap-space-sm">
        <span class="material-symbols-outlined text-primary text-[24px]"
          >receipt_long</span
        >
        <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">
          Resumen del Pedido
        </h3>
      </div>
      <span
        class="font-label-sm text-label-sm text-primary font-bold bg-primary-fixed px-space-sm py-0.5 rounded-full"
        >Paso 1 de 2</span
      >
    </div>

    <div
      class="space-y-space-sm pb-space-lg mb-space-lg border-b border-surface-container-high"
    >
      <div class="flex items-center justify-between">
        <div class="flex flex-col">
          <span class="font-body-md text-body-md font-semibold text-on-surface"
            >Plan WhatsBot Professional</span
          >
          <span class="font-label-sm text-label-sm text-on-surface-variant"
            >Facturación Anual • Prueba gratis de 14 días</span
          >
        </div>
        <span class="font-label-lg text-label-lg font-semibold text-on-surface"
          >$24.00 USD</span
        >
      </div>
      <div class="flex items-center justify-between text-primary font-medium">
        <span class="font-body-md text-body-md flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">sell</span
          >Descuento Anual (2 meses gratis)
        </span>
        <span class="font-label-lg text-label-lg font-bold">-$4.80 USD</span>
      </div>
    </div>

    <div
      class="flex items-baseline justify-between mb-space-lg bg-surface-container-low p-space-md rounded-lg"
    >
      <div>
        <span
          class="font-headline-sm text-headline-sm font-bold text-on-surface block"
          >Total a Pagar Hoy:</span
        >
        <span class="font-body-sm text-body-sm text-primary font-semibold"
          >Luego de 14 días gratis</span
        >
      </div>
      <div class="text-right">
        <span
          class="font-display-lg text-display-lg font-extrabold text-primary"
          id="order-total">$19.20</span
        >
        <span
          class="font-label-md text-label-md text-on-surface-variant block font-medium"
          >USD / mes</span
        >
      </div>
    </div>

    <a
      class="w-full py-space-md px-space-xl bg-primary-container hover:bg-secondary-container text-on-primary font-headline-sm text-headline-sm font-bold rounded-lg shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-space-sm text-center"
      href="#"
      id="btn-proceed"
    >
      <span>Continuar al Pago Seguro ($19.20 USD)</span>
      <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
    </a>
    <p
      class="font-body-sm text-body-sm text-center text-on-surface-variant mt-space-md mb-space-lg"
    >
      Próximo paso: ingresa tu método de pago protegido con cifrado SSL
      bancario.
    </p>

    <div
      class="border-t border-surface-container-high pt-space-md grid grid-cols-1 sm:grid-cols-3 gap-space-sm"
    >
      <div class="flex items-center gap-space-xs text-on-surface">
        <span
          class="material-symbols-outlined text-primary text-[18px]"
          style="font-variation-settings: 'FILL' 1;">shield</span
        >
        <span class="font-label-sm text-label-sm font-medium"
          >Garantía de 14 días</span
        >
      </div>
      <div class="flex items-center gap-space-xs text-on-surface">
        <span class="material-symbols-outlined text-primary text-[18px]"
          >flash_on</span
        >
        <span class="font-label-sm text-label-sm font-medium"
          >Activación inmediata</span
        >
      </div>
      <div class="flex items-center gap-space-xs text-on-surface">
        <span class="material-symbols-outlined text-primary text-[18px]"
          >check_box</span
        >
        <span class="font-label-sm text-label-sm font-medium"
          >Cancela en 1 clic</span
        >
      </div>
    </div>
  </div>
</div>
