---

---

<div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-space-xl">
  <div
    class="bg-surface-container-lowest rounded-xl p-space-lg sm:p-space-xl shadow-sm flex flex-col gap-space-lg sticky top-20"
  >
    <!-- Encabezado del resumen -->
    <div
      class="flex items-center justify-between pb-space-sm border-b border-surface-container-high"
    >
      <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">
        Resumen de tu Orden
      </h2>
      <span
        class="bg-primary/10 text-primary px-space-sm py-0.5 rounded-full font-label-sm text-label-sm font-bold uppercase"
      >
        Lock de Precio
      </span>
    </div>

    <!-- Detalle del plan -->
    <div
      class="bg-surface-container-low rounded-lg p-space-md flex flex-col gap-space-xs"
    >
      <div class="flex items-center justify-between">
        <span
          class="font-headline-sm text-headline-sm font-bold text-on-surface"
          >WhatsBot Professional</span
        >
        <span
          class="font-label-sm text-label-sm bg-secondary-container text-on-secondary-container font-semibold px-2 py-0.5 rounded-full"
          >Anual</span
        >
      </div>
      <p
        class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-space-xxs"
      >
        <span class="material-symbols-outlined text-[16px] text-primary"
          >autorenew</span
        >
        1 Año completo de servicio • Soporte 24/7 VIP
      </p>
      <div class="flex items-center gap-space-xs mt-space-xxs pt-space-xxs">
        <span class="w-2 h-2 rounded-full bg-primary-container"></span>
        <span class="font-label-sm text-label-sm text-on-surface"
          >Flujos ilimitados + GPT-4o integrado</span
        >
      </div>
    </div>

    <!-- Desglose de costos -->
    <div class="flex flex-col gap-space-sm font-body-md text-body-md">
      <div class="flex justify-between items-center text-on-surface-variant">
        <span>Subtotal anual</span>
        <span class="text-on-surface font-medium">$29.00 USD</span>
      </div>
      <div class="flex justify-between items-center text-primary font-medium">
        <div class="flex items-center gap-space-xxs">
          <span class="material-symbols-outlined text-[16px]">celebration</span>
          <span>Ahorro Anual (2 meses gratis)</span>
        </div>
        <span>-$5.00 USD</span>
      </div>
      <div class="flex justify-between items-center text-secondary font-medium">
        <div class="flex items-center gap-space-xxs">
          <span class="material-symbols-outlined text-[16px]">local_offer</span>
          <span>Cupón de Bienvenida (PRIMERPAGO)</span>
        </div>
        <span>-$5.00 USD</span>
      </div>
      <div class="flex justify-between items-center text-on-surface-variant">
        <div class="flex items-center gap-space-xxs">
          <span>Impuestos estimados (IVA 0% export.)</span>
          <span
            class="material-symbols-outlined text-[14px] text-on-surface-variant cursor-pointer"
            title="Aplicación automática según país de origen">info</span
          >
        </div>
        <span class="text-on-surface font-medium">$0.00 USD</span>
      </div>

      <!-- Total -->
      <div
        class="pt-space-md mt-space-xs bg-surface-container-low rounded-lg p-space-md flex flex-col gap-space-xxs"
      >
        <div class="flex justify-between items-baseline">
          <span
            class="font-headline-sm text-headline-sm font-bold text-on-surface"
            >Total a Pagar Hoy:</span
          >
          <div class="flex flex-col items-end">
            <span
              class="font-display-lg text-display-lg font-bold text-primary tracking-tight leading-none"
              >$19.00</span
            >
            <span
              class="font-label-sm text-label-sm text-on-surface-variant mt-1"
              >USD Facturado anualmente</span
            >
          </div>
        </div>
        <div
          class="flex items-center gap-space-xxs text-primary font-label-sm text-label-sm mt-1"
        >
          <span class="material-symbols-outlined text-[14px]">savings</span>
          <span>Estás ahorrando un total de $10.00 USD hoy</span>
        </div>
      </div>
    </div>

    <!-- Garantías -->
    <div class="flex flex-col gap-space-md pt-space-xs">
      <div class="flex items-start gap-space-sm">
        <div
          class="w-8 h-8 rounded-full bg-secondary-container/15 flex items-center justify-center text-secondary shrink-0"
        >
          <span class="material-symbols-outlined text-[18px]">verified</span>
        </div>
        <div class="flex flex-col">
          <span class="font-label-md text-label-md text-on-surface font-bold"
            >Garantía de reembolso de 14 días</span
          >
          <span class="font-body-sm text-body-sm text-on-surface-variant"
            >Prueba WhatsBot sin riesgo. Te devolvemos el 100% de tu dinero si
            no te encanta.</span
          >
        </div>
      </div>

      <div class="flex items-start gap-space-sm">
        <div
          class="w-8 h-8 rounded-full bg-primary-container/15 flex items-center justify-center text-primary shrink-0"
        >
          <span class="material-symbols-outlined text-[18px]">shield</span>
        </div>
        <div class="flex flex-col">
          <span class="font-label-md text-label-md text-on-surface font-bold"
            >Cifrado bancario TLS 1.3 / AES-256</span
          >
          <span class="font-body-sm text-body-sm text-on-surface-variant"
            >Tus datos financieros jamás tocan nuestros servidores.
            Procesamiento auditado.</span
          >
        </div>
      </div>
    </div>

    <!-- Testimonio -->
    <div
      class="bg-surface-container-low rounded-lg p-space-md flex flex-col gap-space-sm"
    >
      <div class="flex items-center text-amber-500 gap-0.5">
        <span class="material-symbols-outlined text-[16px] fill">star</span>
        <span class="material-symbols-outlined text-[16px] fill">star</span>
        <span class="material-symbols-outlined text-[16px] fill">star</span>
        <span class="material-symbols-outlined text-[16px] fill">star</span>
        <span class="material-symbols-outlined text-[16px] fill">star</span>
        <span class="font-label-sm text-label-sm text-on-surface font-bold ml-1"
          >5.0 / 5.0</span
        >
      </div>
      <p class="font-body-sm text-body-sm text-on-surface italic">
        "En menos de 15 minutos nuestro bot ya estaba agendando citas y cerrando
        pedidos por WhatsApp. La mejor inversión que hicimos este año."
      </p>
      <div class="flex items-center gap-space-sm pt-space-xxs">
        <div
          class="w-8 h-8 rounded-full bg-primary-fixed flex items-center justify-center font-bold text-primary text-xs"
        >
          MG
        </div>
        <div class="flex flex-col">
          <span class="font-label-sm text-label-sm font-bold text-on-surface"
            >Mariana Gómez</span
          >
          <span class="font-label-sm text-label-sm text-on-surface-variant"
            >Dueña de Café & Bistro La Candelaria</span
          >
        </div>
      </div>
    </div>
  </div>
</div>
