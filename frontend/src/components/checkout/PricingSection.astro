---

---

<div class="text-center max-w-2xl mx-auto mb-space-3xl">
  <div
    class="inline-flex items-center gap-space-xs bg-primary-fixed/60 text-on-primary-fixed-variant px-space-md py-space-xxs rounded-full mb-space-md shadow-sm"
  >
    <span
      class="material-symbols-outlined text-[16px] text-primary"
      style="font-variation-settings: 'FILL' 1;">bolt</span
    >
    <span
      class="font-label-sm text-label-sm font-semibold tracking-wide uppercase"
      >Configuración de Licencia Oficial</span
    >
  </div>
  <h1
    class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface tracking-tight font-extrabold mb-space-sm"
  >
    Elige el plan ideal para tu negocio en WhatsApp
  </h1>
  <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
    Prueba gratis por 14 días sin compromiso. Activa agentes inteligentes,
    automatiza respuestas y procesa cobros en minutos.
  </p>

  <!-- Toggle Mensual / Anual -->
  <div
    class="mt-space-2xl inline-flex p-1 bg-surface-container-high rounded-full shadow-inner items-center relative"
  >
    <button
      class="py-space-xs px-space-xl rounded-full font-label-md text-label-md transition-all duration-200 text-on-surface-variant hover:text-on-surface cursor-pointer"
      id="toggle-monthly"
      type="button"
    >
      Mensual
    </button>
    <button
      class="py-space-xs px-space-xl rounded-full font-label-md text-label-md transition-all duration-200 bg-surface-container-lowest text-primary shadow-sm font-bold flex items-center gap-space-xs cursor-pointer"
      id="toggle-annual"
      type="button"
    >
      <span>Anual</span>
      <span
        class="bg-primary text-on-primary text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider"
      >
        2 Meses Gratis (-20%)
      </span>
    </button>
  </div>
</div>

<!-- Grid de Planes -->
<div
  class="grid grid-cols-1 lg:grid-cols-3 gap-space-lg mb-space-4xl items-stretch"
  id="plans-grid"
>
  <!-- Plan Starter -->
  <div
    class="plan-card bg-surface-container-lowest rounded-xl p-space-xl flex flex-col justify-between shadow-sm transition-all duration-200 hover:-translate-y-1 cursor-pointer"
    data-plan="starter"
  >
    <div>
      <div class="flex items-center justify-between mb-space-md">
        <span
          class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-bold"
          >Starter</span
        >
        <span
          class="font-label-sm text-label-sm bg-surface-container text-on-surface-variant px-2.5 py-1 rounded-full font-medium"
          >Básico</span
        >
      </div>
      <div class="flex items-baseline gap-1 mb-space-xs">
        <span class="font-display-lg text-display-lg font-bold text-on-surface"
          >$0</span
        >
        <span class="font-body-md text-body-md text-on-surface-variant"
          >/ 14 días gratis</span
        >
      </div>
      <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-xl">
        Ideal para emprendedores y pequeños negocios que inician su
        automatización.
      </p>
      <div class="space-y-space-md mb-space-2xl">
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px] mt-0.5"
            >check_circle</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            ><strong>1 Agente</strong> Bot IA conversacional</span
          >
        </div>
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px] mt-0.5"
            >check_circle</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            >Hasta <strong>500 chats</strong> mensuales</span
          >
        </div>
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px] mt-0.5"
            >check_circle</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            >Menú y catálogo digital interactivo</span
          >
        </div>
      </div>
    </div>
    <button
      class="btn-select-plan w-full py-space-sm px-space-md rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-lg text-label-lg transition-colors cursor-pointer"
      type="button"
    >
      Elegir Starter
    </button>
  </div>

  <!-- Plan Professional -->
  <div
    class="plan-card relative bg-surface-container-lowest rounded-xl p-space-xl flex flex-col justify-between shadow-xl transition-all duration-200 hover:-translate-y-1 ring-2 ring-primary-container cursor-pointer"
    data-plan="pro"
  >
    <div
      class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-primary-container to-secondary-container text-on-primary font-label-sm text-label-sm uppercase tracking-wider font-extrabold px-space-md py-0.5 rounded-full shadow-md flex items-center gap-1"
    >
      <span
        class="material-symbols-outlined text-[14px]"
        style="font-variation-settings: 'FILL' 1;">star</span
      >
      Recomendado • Más Popular
    </div>
    <div>
      <div class="flex items-center justify-between mb-space-md mt-space-xs">
        <span
          class="font-label-md text-label-md uppercase tracking-wider text-primary font-bold"
          >Professional</span
        >
        <span
          class="font-label-sm text-label-sm bg-primary-fixed text-on-primary-fixed-variant px-2.5 py-1 rounded-full font-bold"
          >Ahorra 20%</span
        >
      </div>
      <div class="flex items-baseline gap-1 mb-space-xs">
        <span
          class="font-display-lg text-display-lg font-bold text-on-surface"
          id="pro-price-display">$24</span
        >
        <span class="font-body-md text-body-md text-on-surface-variant"
          >USD / mes</span
        >
      </div>
      <div
        class="font-label-sm text-label-sm text-primary mb-space-md font-semibold"
      >
        Facturado anualmente ($288/año) • 14 días sin costo
      </div>
      <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-xl">
        Potencia completa de ventas, atención automática fluida y cobro directo
        por WhatsApp.
      </p>
      <div class="space-y-space-md mb-space-2xl">
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px]"
            style="font-variation-settings: 'FILL' 1;">verified</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            ><strong>5 Agentes IA</strong> con tono adaptable</span
          >
        </div>
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px]"
            style="font-variation-settings: 'FILL' 1;">verified</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            ><strong>Mensajes y pedidos ilimitados</strong></span
          >
        </div>
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px]"
            style="font-variation-settings: 'FILL' 1;">verified</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            ><strong>Cobros integrados</strong> en WhatsApp</span
          >
        </div>
      </div>
    </div>
    <button
      class="btn-select-plan w-full py-space-sm px-space-md rounded-lg bg-primary-container text-on-primary font-label-lg text-label-lg font-bold shadow-md hover:bg-secondary-container transition-all flex items-center justify-center gap-space-xs cursor-pointer"
      type="button"
    >
      <span class="material-symbols-outlined text-[18px]">check</span>
      <span>Plan Seleccionado</span>
    </button>
  </div>

  <!-- Plan Enterprise -->
  <div
    class="plan-card bg-surface-container-lowest rounded-xl p-space-xl flex flex-col justify-between shadow-sm transition-all duration-200 hover:-translate-y-1 cursor-pointer"
    data-plan="enterprise"
  >
    <div>
      <div class="flex items-center justify-between mb-space-md">
        <span
          class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant font-bold"
          >Enterprise</span
        >
        <span
          class="font-label-sm text-label-sm bg-surface-container text-on-surface-variant px-2.5 py-1 rounded-full font-medium"
          >Escala Masiva</span
        >
      </div>
      <div class="flex items-baseline gap-1 mb-space-xs">
        <span
          class="font-display-lg text-display-lg font-bold text-on-surface"
          id="enterprise-price-display">$79</span
        >
        <span class="font-body-md text-body-md text-on-surface-variant"
          >USD / mes</span
        >
      </div>
      <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-xl">
        Infraestructura dedicada, volumen empresarial y soporte estratégico
        consultivo.
      </p>
      <div class="space-y-space-md mb-space-2xl">
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px] mt-0.5"
            >check_circle</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            ><strong>Agentes bot ilimitados</strong></span
          >
        </div>
        <div class="flex items-start gap-space-sm">
          <span
            class="material-symbols-outlined text-primary text-[18px] mt-0.5"
            >check_circle</span
          >
          <span class="font-body-md text-body-md text-on-surface"
            ><strong>Fine-tuning profundo</strong> con tu catálogo</span
          >
        </div>
      </div>
    </div>
    <button
      class="btn-select-plan w-full py-space-sm px-space-md rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-lg text-label-lg transition-colors cursor-pointer"
      type="button"
    >
      Elegir Enterprise
    </button>
  </div>
</div>

<script is:inline>
  (function initPricingSection() {
    let currentBilling = localStorage.getItem("checkout_billing") || "annual";
    let currentPlan = localStorage.getItem("checkout_plan") || "pro";

    function syncState() {
      localStorage.setItem("checkout_plan", currentPlan);
      localStorage.setItem("checkout_billing", currentBilling);

      const proDisplay = document.getElementById("pro-price-display");
      const entDisplay = document.getElementById("enterprise-price-display");
      if (proDisplay)
        proDisplay.textContent = currentBilling === "annual" ? "$24" : "$29";
      if (entDisplay)
        entDisplay.textContent = currentBilling === "annual" ? "$79" : "$99";

      const cards = document.querySelectorAll(".plan-card");
      cards.forEach((card) => {
        const planKey = card.getAttribute("data-plan");
        const btn = card.querySelector(".btn-select-plan");
        if (planKey === currentPlan) {
          card.classList.add("ring-2", "ring-primary-container", "shadow-xl");
          if (btn) {
            btn.className =
              "btn-select-plan w-full py-space-sm px-space-md rounded-lg bg-primary-container text-on-primary font-label-lg text-label-lg font-bold shadow-md hover:bg-secondary-container transition-all flex items-center justify-center gap-space-xs cursor-pointer";
            btn.innerHTML =
              '<span class="material-symbols-outlined text-[18px]">check</span><span>Plan Seleccionado</span>';
          }
        } else {
          card.classList.remove(
            "ring-2",
            "ring-primary-container",
            "shadow-xl",
          );
          if (btn) {
            btn.className =
              "btn-select-plan w-full py-space-sm px-space-md rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-lg text-label-lg transition-colors cursor-pointer";
            const name = planKey
              ? planKey.charAt(0).toUpperCase() + planKey.slice(1)
              : "";
            btn.innerHTML = "Elegir " + name;
          }
        }
      });

      window.dispatchEvent(
        new CustomEvent("plan-changed", {
          detail: { plan: currentPlan, billing: currentBilling },
        }),
      );
    }

    const grid = document.getElementById("plans-grid");
    if (grid) {
      grid.addEventListener("click", function (e) {
        const card = e.target.closest(".plan-card");
        if (card) {
          const selectedPlan = card.getAttribute("data-plan");
          if (selectedPlan) {
            currentPlan = selectedPlan;
            syncState();
          }
        }
      });
    }

    const btnMonthly = document.getElementById("toggle-monthly");
    const btnAnnual = document.getElementById("toggle-annual");

    if (btnMonthly && btnAnnual) {
      btnMonthly.addEventListener("click", function () {
        currentBilling = "monthly";
        btnMonthly.className =
          "py-space-xs px-space-xl rounded-full font-label-md text-label-md transition-all duration-200 bg-surface-container-lowest text-primary shadow-sm font-bold cursor-pointer";
        btnAnnual.className =
          "py-space-xs px-space-xl rounded-full font-label-md text-label-md transition-all duration-200 text-on-surface-variant hover:text-on-surface flex items-center gap-space-xs cursor-pointer";
        syncState();
      });

      btnAnnual.addEventListener("click", function () {
        currentBilling = "annual";
        btnAnnual.className =
          "py-space-xs px-space-xl rounded-full font-label-md text-label-md transition-all duration-200 bg-surface-container-lowest text-primary shadow-sm font-bold flex items-center gap-space-xs cursor-pointer";
        btnMonthly.className =
          "py-space-xs px-space-xl rounded-full font-label-md text-label-md transition-all duration-200 text-on-surface-variant hover:text-on-surface cursor-pointer";
        syncState();
      });
    }

    syncState();
  })();
</script>
