---

---

<div data-integration="billing-usage" class="lg:col-span-5 flex flex-col gap-4 min-w-0">
  <div
    class="rounded-2xl bg-white border border-zinc-200/80 p-5 sm:p-6 shadow-xs flex flex-col gap-5 min-w-0"
  >
    <div
      class="flex items-center justify-between pb-3 border-b border-zinc-100"
    >
      <div class="flex flex-col">
        <span class="text-xs uppercase tracking-wider text-zinc-400 font-bold"
          >Consumo del Periodo</span
        >
        <h3 class="text-lg sm:text-xl font-bold text-zinc-900">
          Límites y Agentes
        </h3>
      </div>
      <span
        class="w-9 h-9 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center border border-orange-100 shrink-0"
      >
        <span class="material-symbols-outlined text-[20px]">donut_large</span>
      </span>
    </div>

    <!-- Métrica 1 -->
    <div class="flex flex-col gap-1.5">
      <div
        class="flex justify-between items-center text-xs sm:text-sm font-semibold"
      >
        <span class="text-zinc-700">Agentes Bot en Producción</span>
        <span class="text-orange-600 font-bold">5 de 5 (100%)</span>
      </div>
      <div class="w-full h-2.5 rounded-full bg-zinc-100 overflow-hidden">
        <div class="h-full bg-orange-500 rounded-full w-full"></div>
      </div>
      <span class="text-xs text-zinc-500"
        >Capacidad máxima del plan actual alcanzada.</span
      >
    </div>

    <!-- Métrica 2 -->
    <div class="flex flex-col gap-1.5">
      <div
        class="flex justify-between items-center text-xs sm:text-sm font-semibold"
      >
        <span class="text-zinc-700">Mensajes Procesados este Mes</span>
        <span class="text-zinc-900 font-bold"
          >12,450 / <span class="text-orange-600">Ilimitados</span></span
        >
      </div>
      <div class="w-full h-2.5 rounded-full bg-zinc-100 overflow-hidden">
        <div class="h-full bg-amber-500 rounded-full w-3/4"></div>
      </div>
      <span class="text-xs text-zinc-500"
        >Incluye respuestas de IA generativa y catálogo interactivo.</span
      >
    </div>

    <!-- Métrica 3 -->
    <div
      class="p-3 rounded-xl bg-zinc-50 border border-zinc-100 flex items-center justify-between gap-2"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <div
          class="w-8 h-8 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center shrink-0"
        >
          <span class="material-symbols-outlined text-[18px]">phone_iphone</span
          >
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-xs font-bold text-zinc-900 truncate"
            >+34 600 000 000</span
          >
          <span class="text-[11px] text-zinc-500 truncate"
            >Conexión Meta Cloud API</span
          >
        </div>
      </div>
      <span
        class="px-2.5 py-0.5 rounded-full bg-zinc-200 text-zinc-800 text-[11px] font-bold shrink-0"
        >1 Conexión</span
      >
    </div>
  </div>
</div>
