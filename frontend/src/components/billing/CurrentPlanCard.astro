---

---

<div
  class="lg:col-span-7 flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-2xl shadow-sm relative overflow-hidden"
>
  <div
    class="absolute -right-8 -top-8 w-44 h-44 rounded-full bg-primary-fixed/30 blur-2xl pointer-events-none"
  >
  </div>
  <div class="flex flex-col gap-space-lg relative z-10">
    <div class="flex items-start justify-between gap-space-md">
      <div class="flex flex-col">
        <span
          class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold"
          >Plan Actual</span
        >
        <div class="flex items-center gap-space-sm mt-space-xxs">
          <h2 class="font-headline-lg text-headline-lg text-on-surface">
            Tremia Professional
          </h2>
          <span
            class="px-space-sm py-space-xxs rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm flex items-center gap-1 font-semibold"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
            Pago Pendiente
          </span>
        </div>
        <p
          class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"
        >
          Optimizado para cafeterías y retail con alta rotación de comandas vía
          WhatsApp.
        </p>
      </div>
      <div class="text-right shrink-0">
        <div class="flex items-baseline justify-end gap-1">
          <span
            class="font-display-lg text-display-lg text-on-surface tracking-tight font-bold"
            >$24</span
          >
          <span class="font-body-md text-body-md text-on-surface-variant"
            >USD / mes</span
          >
        </div>
        <span class="font-label-sm text-label-sm text-primary font-medium"
          >Facturado anualmente ($288/año)</span
        >
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-space-xs">
      <div
        class="flex items-center gap-space-sm p-space-md rounded-lg bg-surface-container-low"
      >
        <span class="material-symbols-outlined text-[20px] text-primary"
          >forum</span
        >
        <div class="flex flex-col">
          <span class="font-label-md text-label-md text-on-surface"
            >Mensajes Sin Límite</span
          >
          <span class="font-label-sm text-label-sm text-on-surface-variant"
            >Sin tarifas por volumen extra</span
          >
        </div>
      </div>
      <div
        class="flex items-center gap-space-sm p-space-md rounded-lg bg-surface-container-low"
      >
        <span class="material-symbols-outlined text-[20px] text-primary"
          >smart_toy</span
        >
        <div class="flex flex-col">
          <span class="font-label-md text-label-md text-on-surface"
            >5 Agentes IA Entrenados</span
          >
          <span class="font-label-sm text-label-sm text-on-surface-variant"
            >Menús, reservas y entregas</span
          >
        </div>
      </div>
      <div
        class="flex items-center gap-space-sm p-space-md rounded-lg bg-surface-container-low"
      >
        <span class="material-symbols-outlined text-[20px] text-primary"
          >receipt_long</span
        >
        <div class="flex flex-col">
          <span class="font-label-md text-label-md text-on-surface"
            >Integración POS & Pedidos</span
          >
          <span class="font-label-sm text-label-sm text-on-surface-variant"
            >Exportación directa de órdenes</span
          >
        </div>
      </div>
      <div
        class="flex items-center gap-space-sm p-space-md rounded-lg bg-surface-container-low"
      >
        <span class="material-symbols-outlined text-[20px] text-primary"
          >support_agent</span
        >
        <div class="flex flex-col">
          <span class="font-label-md text-label-md text-on-surface"
            >Soporte Prioritario 24/7</span
          >
          <span class="font-label-sm text-label-sm text-on-surface-variant"
            >Asistencia directa WhatsApp</span
          >
        </div>
      </div>
    </div>
  </div>

  <div
    class="flex flex-wrap items-center justify-between gap-space-md pt-space-xl mt-space-lg"
  >
    <div class="flex items-center gap-space-md">
      <a
        class="flex items-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-primary text-on-primary font-label-lg text-label-lg shadow-md hover:bg-secondary transition-all cursor-pointer"
        href="/checkout/payment?plan=pro&billing=annual"
      >
        <span class="material-symbols-outlined text-[18px]">sync</span>
        Renovar Plan Ahora
      </a>
      <a
        class="flex items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors font-label-lg text-label-lg cursor-pointer"
        href="/checkout/plans"
      >
        <span class="material-symbols-outlined text-[18px]">bolt</span>
        Cambiar de Plan
      </a>
    </div>
    <a
      class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1"
      href="#"
    >
      <span>Consultar periodo de gracia</span>
      <span class="material-symbols-outlined text-[14px]">open_in_new</span>
    </a>
  </div>
</div>
