---

---

<div data-integration="billing-plan"
  class="lg:col-span-12 flex flex-col justify-between rounded-2xl bg-white border border-zinc-200/80 p-5 sm:p-7 shadow-xs relative overflow-hidden min-w-0"
>
  <div
    class="absolute -right-8 -top-8 w-44 h-44 rounded-full bg-orange-100/50 blur-2xl pointer-events-none"
  >
  </div>

  <div class="flex flex-col gap-5 relative z-10">
    <div
      class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-4 border-b border-zinc-100"
    >
      <div class="flex flex-col min-w-0">
        <span
          class="text-xs uppercase tracking-wider text-orange-600 font-extrabold"
          >Plan Actual</span
        >
        <div class="flex items-center gap-2 flex-wrap mt-1">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900">
            Tremia Professional
          </h2>
          <span
            data-billing-badge
            class="px-2.5 py-0.5 rounded-full bg-red-100 border border-red-200 text-red-700 text-xs font-bold flex items-center gap-1 shrink-0"
          >
            <span data-billing-dot class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
            Pago Pendiente
          </span>
        </div>
              </div>

      <div
        class="text-left sm:text-right shrink-0 bg-zinc-50 sm:bg-transparent p-3 sm:p-0 rounded-xl border border-zinc-100 sm:border-0"
      >
        <div class="flex items-baseline justify-start sm:justify-end gap-1">
          <span
            class="text-3xl sm:text-4xl font-black text-zinc-900 tracking-tight"
            >$24</span
          >
          <span class="text-xs font-semibold text-zinc-500">USD / mes</span>
        </div>
        <span class="text-xs text-orange-600 font-bold block mt-0.5"
          >Facturado anualmente ($288/año)</span
        >
      </div>
    </div>

  </div>

  <div
    class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-5 mt-5 border-t border-zinc-100"
  >
    <div
      class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5"
    >
      <a
        class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm shadow-xs transition-all cursor-pointer text-center"
        href="/checkout/payment?plan=pro&billing=annual"
      >
        <span class="material-symbols-outlined text-[18px]">sync</span>
        <span>Renovar Plan Ahora</span>
      </a>
      <a
        class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-800 font-bold text-sm transition-colors cursor-pointer text-center"
        href="/checkout/plans"
      >
        <span class="material-symbols-outlined text-[18px]">bolt</span>
        <span>Cambiar de Plan</span>
      </a>
    </div>
    <a
      class="text-xs font-semibold text-zinc-500 hover:text-orange-600 transition-colors flex items-center justify-center sm:justify-start gap-1 mt-1 sm:mt-0"
      href="#"
    >
      <span>Consultar periodo de gracia</span>
      <span class="material-symbols-outlined text-[14px]">open_in_new</span>
    </a>
  </div>
</div>
