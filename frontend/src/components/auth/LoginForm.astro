---

---

<div class="relative w-full max-w-md mx-auto py-unit-lg px-unit-xs">
  <!-- Dynamic Ambient Glow -->
  <div
    class="absolute -top-12 left-1/2 -translate-x-1/2 w-72 h-72 bg-orange-100/60 rounded-full blur-3xl pointer-events-none -z-10"
  >
  </div>

  <div
    class="bg-surface-container-lowest rounded-xl shadow-xl border border-orange-100 p-unit-lg md:p-unit-xl relative z-10"
  >
    <div class="flex flex-col items-center text-center mb-unit-lg">
      <div
        class="w-12 h-12 rounded-xl bg-orange-500 text-white flex items-center justify-center shadow-md mb-unit-sm"
      >
        <span class="material-symbols-outlined text-[28px] fill">smart_toy</span
        >
      </div>
      <h1
        class="font-headline-lg text-headline-lg text-on-surface mb-unit-2xs tracking-tight"
      >
        Iniciar Sesión en Tremia
      </h1>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-xs">
        Gestiona tus agentes y pedidos de WhatsApp en un solo lugar.
      </p>
    </div>

    <!-- Social Logins -->
    <div class="grid gap-unit-sm mb-unit-md">
      <button
        id="btnGoogle"
        class="group flex items-center justify-center gap-unit-xs py-unit-sm px-unit-sm rounded-lg bg-surface-container-low hover:bg-orange-50 text-on-surface transition-colors border border-surface-dim hover:border-orange-200 cursor-pointer"
        type="button"
      >
        <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24">
          <path
            d="M22.56 12.25c0-.7-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
            fill="#EA4335"></path>
        </svg>
        <span
          class="font-label-md text-label-md font-medium text-on-surface group-hover:text-orange-600 transition-colors"
          >Google</span
        >
      </button>
    </div>

    <div class="relative flex items-center justify-center my-unit-md">
      <div class="w-full h-px bg-surface-container-high"></div>
      <span
        class="absolute px-unit-sm bg-surface-container-lowest font-body-sm text-body-sm text-on-surface-variant"
        >o ingresa con tu correo</span
      >
    </div>

    <!-- Formulario Email/Pass -->
    <form class="flex flex-col gap-unit-md" id="loginForm">
      <div class="flex flex-col gap-unit-2xs">
        <label
          class="font-label-md text-label-md text-on-surface font-medium"
          for="email">Correo electrónico empresarial</label
        >
        <div class="relative flex items-center">
          <span
            class="material-symbols-outlined absolute left-unit-sm text-[18px] text-outline pointer-events-none"
            >mail</span
          >
          <input
            class="w-full bg-surface-container-low focus:bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-unit-md py-unit-sm rounded-lg border border-surface-dim placeholder:text-outline outline-none focus:ring-1 focus:ring-orange-500 focus:border-orange-500 transition-all"
            id="email"
            placeholder="nombre@empresa.com"
            required
            type="email"
          />
        </div>
      </div>

      <div class="flex flex-col gap-unit-2xs">
        <div class="flex items-center justify-between">
          <label
            class="font-label-md text-label-md text-on-surface font-medium"
            for="password">Contraseña</label
          >
          <a
            class="font-label-md text-label-md text-orange-600 hover:text-orange-700 transition-colors font-medium"
            href="#">¿Olvidaste tu contraseña?</a
          >
        </div>
        <div class="relative flex items-center">
          <span
            class="material-symbols-outlined absolute left-unit-sm text-[18px] text-outline pointer-events-none"
            >lock</span
          >
          <input
            class="w-full bg-surface-container-low focus:bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-10 pr-10 py-unit-sm rounded-lg border border-surface-dim placeholder:text-outline outline-none focus:ring-1 focus:ring-orange-500 focus:border-orange-500 transition-all"
            id="password"
            placeholder="••••••••••••"
            required
            type="password"
          />
          <button
            aria-label="Mostrar u ocultar contraseña"
            class="absolute right-unit-sm text-outline hover:text-orange-600 transition-colors flex items-center justify-center p-unit-2xs"
            id="togglePassword"
            type="button"
          >
            <span class="material-symbols-outlined text-[18px]" id="eyeIcon"
              >visibility</span
            >
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between pt-unit-2xs">
        <label
          class="inline-flex items-center gap-unit-xs cursor-pointer select-none"
        >
          <input checked class="sr-only peer" id="remember" type="checkbox" />
          <div
            class="w-4 h-4 rounded bg-surface-container-highest peer-checked:bg-orange-500 flex items-center justify-center transition-colors"
          >
            <span
              class="material-symbols-outlined text-white text-[14px] hidden peer-checked:block"
              >check</span
            >
          </div>
          <span class="font-body-sm text-body-sm text-on-surface"
            >Recordar mi sesión</span
          >
        </label>
        <div
          class="flex items-center gap-unit-2xs text-on-surface-variant font-label-sm text-label-sm"
        >
          <span class="material-symbols-outlined text-[14px] text-orange-500"
            >shield</span
          >
          <span>256-bit SSL</span>
        </div>
      </div>

      <button
        id="btnSubmit"
        class="w-full bg-[#f97316] hover:bg-[#ea580c] active:bg-orange-700 text-white py-unit-sm px-unit-lg font-headline-sm text-headline-sm rounded-lg shadow-md transition-all flex items-center justify-center gap-unit-xs group mt-unit-xs cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        type="submit"
      >
        <span id="btnText">Iniciar Sesión</span>
        <span
          class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1"
          >arrow_forward</span
        >
      </button>
    </form>

    <div
      class="mt-unit-lg pt-unit-md border-t border-surface-container-high text-center"
    >
      <p class="font-body-sm text-body-sm text-on-surface-variant">
        ¿Aún no tienes cuenta? <a
          class="font-label-md text-label-md text-orange-600 hover:text-orange-700 font-semibold transition-colors"
          href="/register">Regístrate gratis por 14 días</a
        >
      </p>
    </div>
  </div>
</div>

<script>
  import { authService } from "../../services/auth.service";

  const togglePasswordBtn = document.getElementById("togglePassword");
  const passwordField = document.getElementById("password") as HTMLInputElement;
  const eyeIcon = document.getElementById("eyeIcon");

  if (togglePasswordBtn && passwordField && eyeIcon) {
    togglePasswordBtn.addEventListener("click", () => {
      const isPassword = passwordField.type === "password";
      passwordField.type = isPassword ? "text" : "password";
      eyeIcon.textContent = isPassword ? "visibility_off" : "visibility";
    });
  }

  const btnGoogle = document.getElementById("btnGoogle");
  btnGoogle?.addEventListener("click", (e) => {
    e.preventDefault(); // Detiene cualquier comportamiento por defecto
    authService.loginWithGoogle();
  });
</script>
