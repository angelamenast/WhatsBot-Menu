<div data-integration="orders-header"
  class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8 min-w-0"
>
  <!-- Título y Estado -->
  <div class="flex flex-col gap-1.5 min-w-0">
    <h1
      class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight leading-tight"
    >
      Tablero de Pedidos
    </h1>
    <p class="text-sm sm:text-base text-zinc-600 max-w-2xl leading-relaxed">
      Gestioná pedidos y solicitudes de WhatsApp para <strong
        data-profile-business class="text-zinc-900">Mi negocio</strong
      >.
    </p>
  </div>

  <!-- Métricas Rápidas y CTA -->
  <div class="flex items-center gap-4 flex-wrap shrink-0">
    <!-- Ventas de Hoy -->
    <div
      class="flex items-center gap-3.5 px-4 py-3 rounded-2xl bg-white border border-zinc-200/80 shadow-2xs"
    >
      <div
        class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center border border-orange-100 shrink-0"
      >
        <span class="material-symbols-outlined text-[22px]">payments</span>
      </div>
      <div class="flex flex-col">
        <span
          class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider"
          >Ventas de Hoy</span
        >
        <span class="text-lg font-extrabold text-zinc-900 tracking-tight"
          >$18,450.00</span
        >
      </div>
    </div>


  </div>
</div>
