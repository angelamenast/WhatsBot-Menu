---

---

<div
  class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8 min-w-0"
>
  <!-- Título y Estado -->
  <div class="flex flex-col gap-1.5 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <span
        class="px-2.5 py-0.5 rounded-full bg-orange-100 text-orange-700 font-semibold text-xs flex items-center gap-1.5"
      >
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
        Canal en vivo
      </span>
      <span class="text-xs text-zinc-500 font-medium">Actualizado hace 12s</span
      >
    </div>
    <h1
      class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight leading-tight"
    >
      Tablero de Pedidos
    </h1>
    <p class="text-sm sm:text-base text-zinc-600 max-w-2xl leading-relaxed">
      Gestioná pedidos y solicitudes de WhatsApp en tiempo real para <strong
        class="text-zinc-900">Main Street Cafe</strong
      >.
    </p>
  </div>

  <!-- Métricas Rápidas y CTA -->
  <div class="flex items-center gap-4 flex-wrap shrink-0">
    <!-- Ventas de Hoy -->
    <div
      class="flex items-center gap-3.5 px-4 py-3 rounded-2xl bg-white border border-zinc-200/80 shadow-2xs"
    >
      <div
        class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center border border-orange-100 shrink-0"
      >
        <span class="material-symbols-outlined text-[22px]">payments</span>
      </div>
      <div class="flex flex-col">
        <span
          class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider"
          >Ventas de Hoy</span
        >
        <span class="text-lg font-extrabold text-zinc-900 tracking-tight"
          >$18,450.00</span
        >
      </div>
    </div>

    <!-- Demora Media -->
    <div
      class="flex items-center gap-3.5 px-4 py-3 rounded-2xl bg-white border border-zinc-200/80 shadow-2xs"
    >
      <div
        class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-100 shrink-0"
      >
        <span class="material-symbols-outlined text-[22px]">timer</span>
      </div>
      <div class="flex flex-col">
        <span
          class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider"
          >Demora Media</span
        >
        <span class="text-lg font-extrabold text-zinc-900 tracking-tight"
          >11 min</span
        >
      </div>
    </div>

    <!-- Botón Nuevo Pedido -->
    <button
      class="w-full sm:w-auto px-5 py-3 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer shrink-0"
    >
      <span class="material-symbols-outlined text-[20px]">add</span>
      <span>Nuevo Pedido Manual</span>
    </button>
  </div>
</div>
