---

---

<div data-integration="orders-filters"
  class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-8 p-2 bg-white border border-zinc-200/80 rounded-2xl shadow-2xs min-w-0"
>
  <!-- Input de Búsqueda -->
  <div class="relative flex-1 min-w-0">
    <span
      class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 text-[20px]"
      >search</span
    >
    <input
      id="orderSearchInput"
      type="text"
      placeholder="Buscar por cliente, WhatsApp o ítem..."
      class="w-full pl-10 pr-4 py-2 rounded-xl bg-zinc-50 border border-transparent text-sm text-zinc-900 placeholder:text-zinc-400 focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all focus:outline-none"
    />
  </div>

  <!-- Pills de Filtro -->
  <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 min-w-0">
    <button
      class="px-4 py-2 rounded-xl bg-orange-500 text-white font-bold text-xs shrink-0 shadow-2xs cursor-pointer"
    >
      Todos (6)
    </button>
    <button
      class="px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200/70 text-zinc-700 font-semibold text-xs shrink-0 transition-colors cursor-pointer"
    >
      Mesas / Take Away
    </button>
    <button
      class="px-4 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200/70 text-zinc-700 font-semibold text-xs shrink-0 transition-colors cursor-pointer"
    >
      Delivery WhatsApp
    </button>
    <button
      class="w-9 h-9 flex items-center justify-center rounded-xl bg-zinc-100 hover:bg-zinc-200/70 text-zinc-600 transition-colors shrink-0 cursor-pointer"
      title="Más Filtros"
    >
      <span class="material-symbols-outlined text-[20px]">filter_list</span>
    </button>
  </div>
</div>
