---

---

<section
  class="bg-white rounded-2xl p-6 border border-zinc-200/80 shadow-sm flex flex-col gap-6"
>
  <div class="flex items-center gap-3">
    <div
      class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center"
    >
      <span class="material-symbols-outlined text-[22px]">alternate_email</span>
    </div>
    <div>
      <h2 class="text-base font-bold text-zinc-900">
        Modificar Correo Electrónico
      </h2>
      <p class="text-xs text-zinc-500">
        Gestiona la dirección que recibe reportes diarios y alertas
      </p>
    </div>
  </div>

  <div
    class="p-3.5 rounded-xl bg-amber-50/60 border border-amber-200/60 flex items-start gap-3"
  >
    <span
      class="material-symbols-outlined text-amber-600 text-[20px] shrink-0 mt-0.5"
      >info</span
    >
    <p class="text-xs text-amber-900 leading-relaxed">
      Este correo se utiliza para iniciar sesión, recuperar credenciales y
      recibir reportes automáticos de ventas.
    </p>
  </div>

  <form class="flex flex-col gap-4" id="email-form" novalidate>
    <div class="flex flex-col gap-1.5">
      <label class="text-xs font-medium text-zinc-700"
        >Correo electrónico actual</label
      >
      <div
        class="flex items-center justify-between p-3 rounded-xl bg-zinc-50 border border-zinc-200/80 text-zinc-900"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="material-symbols-outlined text-zinc-400 text-[18px]"
            >mail</span
          >
          <span id="current-email-display" class="text-sm font-medium truncate"
            >alex.ramirez@gmail.com</span
          >
        </div>
        <div
          class="flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-semibold text-[11px] shrink-0"
        >
          <span class="material-symbols-outlined text-[14px]">verified</span>
          <span>Verificado</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-zinc-700" for="new-email"
          >Nuevo correo electrónico</label
        >
        <div class="relative">
          <span
            class="material-symbols-outlined absolute left-3 top-2.5 text-zinc-400 text-[18px]"
            >add</span
          >
          <input
            class="w-full bg-white text-zinc-900 rounded-xl pl-9 pr-3 py-2 text-sm border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all"
            id="new-email"
            placeholder="ej. cafe@mainst.com"
            type="email"
          />
        </div>
        <span
          id="new-email-error"
          class="text-[11px] text-rose-500 hidden font-medium"></span>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-zinc-700" for="confirm-new-email"
          >Confirmar nuevo correo</label
        >
        <div class="relative">
          <span
            class="material-symbols-outlined absolute left-3 top-2.5 text-zinc-400 text-[18px]"
            >check_circle</span
          >
          <input
            class="w-full bg-white text-zinc-900 rounded-xl pl-9 pr-3 py-2 text-sm border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all"
            id="confirm-new-email"
            placeholder="repite el nuevo correo"
            type="email"
          />
        </div>
        <span
          id="confirm-email-error"
          class="text-[11px] text-rose-500 hidden font-medium"></span>
      </div>
    </div>

    <div class="flex items-center justify-end pt-2">
      <!-- Botón bloqueado por defecto con disabled -->
      <button
        id="btn-submit-email"
        class="px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-zinc-900 text-white font-medium text-sm transition-all flex items-center gap-2 cursor-pointer shadow-sm"
        type="submit"
        disabled
      >
        <span class="material-symbols-outlined text-[18px]">send</span>
        <span>Solicitar Código de Cambio</span>
      </button>
    </div>
  </form>
</section>

<!-- Modal OTP -->
<div
  id="otp-modal"
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4 hidden"
>
  <div
    class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl flex flex-col gap-4 border border-zinc-100"
  >
    <div class="flex items-center justify-between">
      <h3 class="text-base font-bold text-zinc-900">Confirmar Verificación</h3>
      <button
        id="close-otp-modal"
        class="text-zinc-400 hover:text-zinc-700 text-sm cursor-pointer"
        >✕</button
      >
    </div>
    <p class="text-xs text-zinc-500 leading-relaxed">
      Ingresa el código de 6 dígitos enviado a tu nuevo correo para confirmar la
      actualización.
    </p>

    <div class="flex justify-between gap-2 my-2">
      <input
        type="text"
        maxlength="1"
        class="otp-input w-10 h-12 text-center text-lg font-bold border border-zinc-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none"
      />
      <input
        type="text"
        maxlength="1"
        class="otp-input w-10 h-12 text-center text-lg font-bold border border-zinc-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none"
      />
      <input
        type="text"
        maxlength="1"
        class="otp-input w-10 h-12 text-center text-lg font-bold border border-zinc-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none"
      />
      <input
        type="text"
        maxlength="1"
        class="otp-input w-10 h-12 text-center text-lg font-bold border border-zinc-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none"
      />
      <input
        type="text"
        maxlength="1"
        class="otp-input w-10 h-12 text-center text-lg font-bold border border-zinc-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none"
      />
      <input
        type="text"
        maxlength="1"
        class="otp-input w-10 h-12 text-center text-lg font-bold border border-zinc-200 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none"
      />
    </div>

    <button
      id="btn-verify-otp"
      class="w-full py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-medium text-sm transition-colors cursor-pointer shadow-sm"
    >
      Verificar y Cambiar Correo
    </button>
  </div>
</div>

<script>
  const emailForm = document.getElementById("email-form");
  const newEmail = document.getElementById("new-email") as HTMLInputElement;
  const confirmEmail = document.getElementById(
    "confirm-new-email",
  ) as HTMLInputElement;
  const currentEmailDisplay = document.getElementById("current-email-display");
  const btnSubmit = document.getElementById(
    "btn-submit-email",
  ) as HTMLButtonElement;

  const newEmailError = document.getElementById("new-email-error");
  const confirmEmailError = document.getElementById("confirm-email-error");

  const otpModal = document.getElementById("otp-modal");
  const closeOtp = document.getElementById("close-otp-modal");
  const verifyBtn = document.getElementById("btn-verify-otp");
  const otpInputs = document.querySelectorAll<HTMLInputElement>(".otp-input");

  // Regex para formato estándar de correo
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const showError = (
    input: HTMLInputElement,
    errorSpan: HTMLElement | null,
    msg: string,
  ) => {
    input.classList.add(
      "border-rose-500",
      "focus:ring-rose-500/20",
      "focus:border-rose-500",
    );
    input.classList.remove(
      "border-zinc-200",
      "focus:ring-orange-500/20",
      "focus:border-orange-500",
    );
    if (errorSpan) {
      errorSpan.textContent = msg;
      errorSpan.classList.remove("hidden");
    }
  };

  const clearError = (
    input: HTMLInputElement,
    errorSpan: HTMLElement | null,
  ) => {
    input.classList.remove(
      "border-rose-500",
      "focus:ring-rose-500/20",
      "focus:border-rose-500",
    );
    input.classList.add(
      "border-zinc-200",
      "focus:ring-orange-500/20",
      "focus:border-orange-500",
    );
    if (errorSpan) {
      errorSpan.classList.add("hidden");
    }
  };

  // Función de validación en tiempo real
  const validateLive = () => {
    const valNew = newEmail.value.trim().toLowerCase();
    const valConfirm = confirmEmail.value.trim().toLowerCase();
    const currentEmail = currentEmailDisplay?.textContent?.trim().toLowerCase();

    let isNewValid = false;
    let isConfirmValid = false;

    // 1. Validar el campo "Nuevo correo"
    if (!valNew) {
      clearError(newEmail, newEmailError);
    } else if (!emailRegex.test(valNew)) {
      showError(
        newEmail,
        newEmailError,
        "Ingresa un correo válido (ej. usuario@dominio.com)",
      );
    } else if (valNew === currentEmail) {
      showError(
        newEmail,
        newEmailError,
        "El nuevo correo no puede ser igual al actual",
      );
    } else {
      clearError(newEmail, newEmailError);
      isNewValid = true;
    }

    // 2. Validar el campo "Confirmar correo"
    if (!valConfirm) {
      clearError(confirmEmail, confirmEmailError);
    } else if (valConfirm !== valNew) {
      showError(
        confirmEmail,
        confirmEmailError,
        "Los correos electrónicos no coinciden",
      );
    } else {
      clearError(confirmEmail, confirmEmailError);
      isConfirmValid = true;
    }

    // 3. Activar/Desactivar el botón automáticamente
    if (isNewValid && isConfirmValid) {
      btnSubmit.removeAttribute("disabled");
    } else {
      btnSubmit.setAttribute("disabled", "true");
    }
  };

  // Escuchar eventos de escritura en ambos campos
  newEmail?.addEventListener("input", validateLive);
  confirmEmail?.addEventListener("input", validateLive);

  // Al enviar cuando el botón ya está habilitado
  emailForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (btnSubmit.hasAttribute("disabled")) return;

    otpModal?.classList.remove("hidden");
    (window as any).showToast?.(
      `Código enviado a ${newEmail.value.trim()}`,
      "info",
    );
  });

  closeOtp?.addEventListener("click", () => otpModal?.classList.add("hidden"));

  // Salto automático entre casillas OTP
  otpInputs.forEach((input, index) => {
    input.addEventListener("input", () => {
      if (input.value && index < otpInputs.length - 1) {
        otpInputs[index + 1].focus();
      }
    });
  });

  verifyBtn?.addEventListener("click", () => {
    const code = Array.from(otpInputs)
      .map((i) => i.value)
      .join("");
    if (code.length < 6) {
      (window as any).showToast?.(
        "Ingresa el código completo de 6 dígitos",
        "error",
      );
      return;
    }

    if (currentEmailDisplay && newEmail) {
      currentEmailDisplay.textContent = newEmail.value.trim();
      otpModal?.classList.add("hidden");
      (window as any).showToast?.("¡Correo actualizado correctamente!");

      // Limpiar formulario y re-bloquear botón
      (emailForm as HTMLFormElement).reset();
      btnSubmit.setAttribute("disabled", "true");
      otpInputs.forEach((i) => (i.value = ""));
    }
  });

  verifyBtn?.addEventListener("click", () => {
    const code = Array.from(otpInputs)
      .map((i) => i.value)
      .join("");
    if (code.length < 6) {
      (window as any).showToast?.(
        "Ingresa el código completo de 6 dígitos",
        "error",
      );
      return;
    }

    const updatedEmail = newEmail.value.trim();

    if (currentEmailDisplay && newEmail) {
      currentEmailDisplay.textContent = updatedEmail;
      otpModal?.classList.add("hidden");
      (window as any).showToast?.("¡Correo actualizado correctamente!");

      // Emitir cambio global al Sidebar y localStorage
      const currentSaved = JSON.parse(
        localStorage.getItem("user_profile_data") || "{}",
      );
      const updatedData = { ...currentSaved, email: updatedEmail };
      localStorage.setItem("user_profile_data", JSON.stringify(updatedData));

      window.dispatchEvent(
        new CustomEvent("profile-updated", { detail: updatedData }),
      );

      // Limpiar formulario
      (emailForm as HTMLFormElement).reset();
      btnSubmit.setAttribute("disabled", "true");
      otpInputs.forEach((i) => (i.value = ""));
    }
  });
</script>
