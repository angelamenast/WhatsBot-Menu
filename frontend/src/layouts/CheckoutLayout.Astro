---
import Logo from "../components/common/Logo.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "WhatsBot - Checkout" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Fuentes e Iconos -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
  </head>

  <body
    class="bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col justify-between"
  >
    <!-- Header -->
    <header
      class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
    >
      <div
        class="h-16 max-w-container-max mx-auto px-gutter-mobile lg:px-gutter-desktop flex items-center justify-between"
      >
        <div class="flex items-center gap-space-md">
          <a
            class="flex items-center gap-space-xs text-on-surface-variant hover:text-on-surface transition-colors py-space-xs pr-space-sm"
            href="/register"
          >
            <span class="material-symbols-outlined text-body-lg"
              >arrow_back</span
            >
            <span class="font-label-md text-label-md hidden sm:inline"
              >Volver</span
            >
          </a>
          <div class="h-4 w-px bg-surface-container-high hidden sm:block"></div>
          <a class="flex items-center gap-space-sm" href="/">
            <Logo />
          </a>
        </div>

        <nav class="hidden md:flex items-center gap-space-base">
          <a
            class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors px-space-sm py-space-xs rounded-lg"
            href="/checkout/plans">Checkout</a
          >
          <a
            class="transition-colors px-space-sm py-space-xs bg-primary-container text-on-primary-container font-semibold rounded-lg"
            href="#">Resumen</a
          >
          <a
            class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors px-space-sm py-space-xs rounded-lg"
            href="/checkout/payment">Pago</a
          >
          <a
            class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors px-space-sm py-space-xs rounded-lg"
            href="#">Facturas</a
          >
        </nav>

        <div class="flex items-center gap-space-md">
          <div
            class="flex items-center gap-space-xs bg-surface-container-low px-space-md py-space-xs rounded-full shadow-sm"
          >
            <span class="material-symbols-outlined text-primary text-body-md"
              >lock</span
            >
            <span
              class="font-label-sm text-label-sm text-on-surface-variant tracking-wide font-medium"
              >SSL 256-Bit</span
            >
          </div>
          <div
            class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shadow-sm"
          >
            <span class="material-symbols-outlined text-on-primary text-[18px]"
              >person</span
            >
          </div>
        </div>
      </div>
    </header>

    <!-- Contenido Dinámico -->
    <main class="w-full pt-16 bg-surface flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="w-full bg-surface-container-lowest shadow-[0_-1px_6px_rgba(0,0,0,0.02)] py-space-xl"
    >
      <div
        class="max-w-container-max mx-auto px-gutter-mobile lg:px-gutter-desktop flex flex-col sm:flex-row items-center justify-between gap-space-base"
      >
        <div class="flex items-center gap-space-md text-on-surface-variant">
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-body-md text-primary"
              >verified_user</span
            >
            <span class="font-label-sm text-label-sm"
              >Seguridad Grado Bancario</span
            >
          </div>
          <span class="text-outline-variant">•</span>
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-body-md text-primary"
              >schedule</span
            >
            <span class="font-label-sm text-label-sm"
              >Cancela cuando quieras</span
            >
          </div>
        </div>
        <div class="flex items-center gap-space-lg">
          <a
            class="font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-colors"
            href="#">Términos y Privacidad</a
          >
          <span class="font-body-sm text-body-sm text-on-surface-variant"
            >© 2026 WhatsBot Inc.</span
          >
        </div>
      </div>
    </footer>
  </body>
</html>
