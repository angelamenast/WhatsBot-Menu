---
import SessionGuard from '../components/common/SessionGuard.astro';
const requireSession = ['/profile', '/orders', '/billing', '/vincular-whatsapp', '/checkout/', '/support'].some(path => Astro.url.pathname.startsWith(path));
import Sidebar from "../components/common/Sidebar.astro";
import Navbar from "../components/common/Navbar.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" data-app-state={requireSession ? "loading" : undefined} data-identity-state={requireSession ? "loading" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background font-body-md text-on-surface min-h-screen antialiased overflow-x-hidden"
  >
    <!-- Sidebar Drawer Responsivo -->
    <Sidebar />

    <!-- Padding corregido: pl-0 en móvil y lg:pl-72 en escritorio -->
    <div class="pl-0 lg:pl-72 min-h-screen flex flex-col w-full min-w-0">
      <!-- Header Unificado de la App -->
      <Navbar variant="app" />

      <main data-page-content aria-busy={requireSession ? "true" : undefined} inert={requireSession}
        class="w-full pt-20 px-4 sm:px-6 lg:px-8 pb-12 flex-1 bg-background min-w-0 overflow-hidden"
      >
        <slot />
      </main>
    </div>
    {requireSession && (
      <div data-page-loader role="status" aria-live="polite">
        <span data-page-spinner aria-hidden="true"></span>
        <p data-page-message>Cargando tu información…</p>
        <button data-page-retry type="button" hidden>Volver a intentar</button>
      </div>
    )}
    {requireSession && <SessionGuard />}
    <script>
      import '../services/view-integration';
    </script>
  </body>
</html>
