---
import OrdersLayout from "../layouts/OrdersLayout.astro";
import OrdersHeader from "../components/orders/OrdersHeader.astro";
import OrdersFilterBar from "../components/orders/OrdersFilterBar.astro";
import KanbanBoard from "../components/orders/KanbanBoard.astro";
---

<OrdersLayout title="Tablero de Pedidos - Tremia" activeRoute="orders">
  <div class="flex flex-col w-full max-w-full min-w-0">
    <!-- Encabezado con métricas -->
    <OrdersHeader />

    <!-- Barra de búsqueda y filtros -->
    <OrdersFilterBar />

    <!-- Tablero Kanban -->
    <KanbanBoard />

  </div>
</OrdersLayout>
