---
import DashboardLayout from "../layouts/ProfileLayout.astro";
import ProfileCard from "../components/profile/ProfileCard.astro";
import EmailCard from "../components/profile/EmailCard.astro";
import PasswordCard from "../components/profile/PasswordCard.astro";
import SecurityCards from "../components/profile/SecurityCards.astro";
import Toast from "../components/profile/Toast.astro";
---

<DashboardLayout title="Perfil y Seguridad - Tremia">
  <div class="flex flex-col w-full max-w-full gap-6 sm:gap-8 min-w-0">
    <!-- Encabezado de la Sección -->
    <section
      class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-2 border-b border-zinc-200/60"
    >
      <div class="flex flex-col gap-1.5 min-w-0">
        <div
          class="flex items-center gap-1.5 text-xs text-zinc-500 font-medium flex-wrap"
        >
          <span>Configuración de Cuenta</span>
          <span class="material-symbols-outlined text-[14px]"
            >chevron_right</span
          >
          <span class="text-orange-600 font-bold">Perfil y Seguridad</span>
        </div>
        <h1
          class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight leading-tight"
        >
          Perfil y Seguridad
        </h1>
        <p
          class="text-sm sm:text-base text-zinc-600 max-w-2xl leading-relaxed mt-0.5"
        >
          Administra tu información personal, actualiza tu correo electrónico de
          acceso y gestiona la seguridad de tu contraseña y credenciales.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <div
          class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-zinc-200/80 text-zinc-700 text-xs font-semibold shadow-2xs"
        >
          <span
            class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shrink-0"
          ></span>
          <span>Cuenta Verificada</span>
          <span class="text-zinc-400 font-normal">· Google Workspace</span>
        </div>
      </div>
    </section>

    <!-- Grilla de Formularios -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start min-w-0"
    >
      <div class="lg:col-span-7 flex flex-col gap-6 min-w-0">
        <ProfileCard />
        <EmailCard />
        <PasswordCard />
      </div>

      <div class="lg:col-span-5 flex flex-col gap-6 min-w-0">
        <SecurityCards />
      </div>
    </div>
  </div>

  <Toast />
</DashboardLayout>
