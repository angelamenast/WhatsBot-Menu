---
import QrCard from "../components/vinculacionWpp/QrCard.astro";
import ChatPreviewCard from "../components/vinculacionWpp/ChatPreviewCard.astro";
import RequirementsCard from "../components/vinculacionWpp/RequirementsCard.astro";
import FaqCard from "../components/vinculacionWpp/FaqCard.astro";
import VinculacionWppLayout from "../layouts/VinculacionWppLayout.astro";
---

<VinculacionWppLayout
  title="Vincular Número de WhatsApp | Tremia"
  activeRoute="vincular"
>
  <div class="flex flex-col w-full gap-6">
    <!-- Encabezado y Badges -->
    <section
      class="flex flex-col lg:flex-row lg:items-center justify-between gap-4"
    >
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-1.5 text-on-surface-variant text-xs">
          <span>Configuración</span>
          <span class="material-symbols-outlined text-[14px]"
            >chevron_right</span
          >
          <span>Canales de Venta</span>
          <span class="material-symbols-outlined text-[14px]"
            >chevron_right</span
          >
          <span class="text-primary font-semibold">Vincular WhatsApp</span>
        </div>
        <h1 class="text-2xl font-bold text-on-surface">
          Vincular Número de WhatsApp
        </h1>
        <p class="text-xs text-on-surface-variant max-w-2xl">
          Sincroniza tu línea comercial de WhatsApp para activar las respuestas
          del agente de IA y gestionar pedidos automáticamente.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 self-start lg:self-auto">
        <div
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-xs border border-outline-variant/40"
        >
          <span class="material-symbols-outlined text-[16px] text-primary"
            >verified</span
          >
          <span class="font-semibold">Meta Cloud API Partner</span>
        </div>
        <div
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-xs border border-outline-variant/40"
        >
          <span class="material-symbols-outlined text-[16px] text-primary"
            >lock</span
          >
          <span>Cifrado SSL 256 bits</span>
        </div>
        <div
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed text-xs border border-primary-container/20"
        >
          <span
            class="w-2.5 h-2.5 rounded-full bg-primary-container animate-ping"
          ></span>
          <span class="font-semibold">Esperando vinculación</span>
        </div>
      </div>
    </section>

    <!-- Grid Principal de 2 Columnas -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <QrCard />
      </div>

      <div class="lg:col-span-5 flex flex-col gap-6">
        <ChatPreviewCard />
        <RequirementsCard />
        <FaqCard />
      </div>
    </div>
  </div>
</VinculacionWppLayout>
