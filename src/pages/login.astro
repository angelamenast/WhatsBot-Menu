---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/common/Footer.astro";
import LoginForm from "../components/auth/LoginForm.astro";
import Logo from "../components/common/Logo.astro";
---

<Layout title="Iniciar Sesión - Tremia">
  <!-- Micro Header Bar -->
  <header
    class="w-full px-gutter-mobile md:px-gutter-desktop py-unit-lg flex items-center justify-between border-b border-border-technical bg-surface-container-lowest"
  >
    <Logo />
    <a
      class="inline-flex items-center gap-unit-xs font-label-md text-label-md text-on-surface-variant hover:text-orange-600 transition-colors"
      href="/"
    >
      <span class="material-symbols-outlined text-[16px]">arrow_back</span>
      <span>Volver al inicio</span>
    </a>
  </header>

  <main
    class="flex-1 flex items-center justify-center px-gutter-mobile md:px-gutter-desktop py-unit-xl"
  >
    <LoginForm />
  </main>

  <Footer />
</Layout>
