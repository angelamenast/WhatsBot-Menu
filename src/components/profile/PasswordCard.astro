---
import "/src/styles/global.css";
---

<section
  class="bg-white rounded-2xl p-6 border border-zinc-200/80 shadow-sm flex flex-col gap-6"
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div
        class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center"
      >
        <span class="material-symbols-outlined text-[22px]">lock_reset</span>
      </div>
      <div>
        <h2 class="text-base font-bold text-zinc-900">
          Seguridad y Cambio de Contraseña
        </h2>
        <p class="text-xs text-zinc-500">
          Crea una contraseña segura con al menos 8 caracteres
        </p>
      </div>
    </div>
  </div>

  <form class="flex flex-col gap-4" id="password-form" novalidate>
    <!-- Contraseña Actual -->
    <div class="flex flex-col gap-1.5">
      <div class="flex items-center justify-between">
        <label class="text-xs font-medium text-zinc-700" for="current-password"
          >Contraseña actual</label
        >
        <a class="text-xs text-orange-600 hover:underline font-medium" href="#"
          >¿Olvidaste tu contraseña?</a
        >
      </div>
      <div class="relative">
        <span
          class="material-symbols-outlined absolute left-3 top-2.5 text-zinc-400 text-[18px]"
          >key</span
        >
        <input
          class="w-full bg-white text-zinc-900 rounded-xl pl-9 pr-10 py-2 text-sm border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all"
          id="current-password"
          type="password"
        />
        <button
          class="toggle-password absolute right-3 top-2.5 text-zinc-400 hover:text-zinc-700 cursor-pointer"
          data-target="current-password"
          type="button"
        >
          <span class="material-symbols-outlined text-[18px]">visibility</span>
        </button>
      </div>
      <span
        id="current-password-error"
        class="text-[11px] text-rose-500 hidden font-medium"></span>
    </div>

    <!-- Nueva Contraseña & Confirmar -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Nueva Contraseña -->
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-zinc-700" for="new-password"
          >Nueva contraseña</label
        >
        <div class="relative">
          <span
            class="material-symbols-outlined absolute left-3 top-2.5 text-zinc-400 text-[18px]"
            >lock</span
          >
          <input
            class="w-full bg-white text-zinc-900 rounded-xl pl-9 pr-10 py-2 text-sm border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all"
            id="new-password"
            placeholder="Mínimo 8 caracteres"
            type="password"
          />
          <button
            class="toggle-password absolute right-3 top-2.5 text-zinc-400 hover:text-zinc-700 cursor-pointer"
            data-target="new-password"
            type="button"
          >
            <span class="material-symbols-outlined text-[18px]">visibility</span
            >
          </button>
        </div>
        <span
          id="new-password-error"
          class="text-[11px] text-rose-500 hidden font-medium"></span>
      </div>

      <!-- Confirmar Nueva Contraseña -->
      <div class="flex flex-col gap-1.5">
        <label
          class="text-xs font-medium text-zinc-700"
          for="confirm-new-password">Confirmar nueva contraseña</label
        >
        <div class="relative">
          <span
            class="material-symbols-outlined absolute left-3 top-2.5 text-zinc-400 text-[18px]"
            >lock_clock</span
          >
          <input
            class="w-full bg-white text-zinc-900 rounded-xl pl-9 pr-10 py-2 text-sm border border-zinc-200 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all"
            id="confirm-new-password"
            placeholder="Repite la contraseña"
            type="password"
          />
          <button
            class="toggle-password absolute right-3 top-2.5 text-zinc-400 hover:text-zinc-700 cursor-pointer"
            data-target="confirm-new-password"
            type="button"
          >
            <span class="material-symbols-outlined text-[18px]">visibility</span
            >
          </button>
        </div>
        <span
          id="confirm-password-error"
          class="text-[11px] text-rose-500 hidden font-medium"></span>
      </div>
    </div>

    <!-- Recuadro Dinámico de Fortaleza y Requisitos -->
    <div
      class="p-3.5 rounded-xl bg-zinc-50 border border-zinc-100 flex flex-col gap-2"
    >
      <div class="flex items-center justify-between text-xs">
        <span class="text-zinc-500 font-medium">Fortaleza estimada:</span>
        <span id="strength-label" class="font-bold text-zinc-400"
          >Sin ingresar</span
        >
      </div>
      <div
        class="w-full h-2 rounded-full bg-zinc-200 overflow-hidden flex gap-1"
      >
        <div id="bar-1" class="h-full w-1/3 bg-zinc-300 transition-colors">
        </div>
        <div id="bar-2" class="h-full w-1/3 bg-zinc-300 transition-colors">
        </div>
        <div id="bar-3" class="h-full w-1/3 bg-zinc-300 transition-colors">
        </div>
      </div>
      <div
        class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1 text-[11px] text-zinc-500"
      >
        <div id="req-length" class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">circle</span> +8 caracteres
        </div>
        <div id="req-upper" class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">circle</span> Mayúscula
        </div>
        <div id="req-number" class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">circle</span> Número
        </div>
        <div id="req-special" class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">circle</span> Símbolo
          especial
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end pt-2">
      <!-- Botón Bloqueado por Defecto -->
      <button
        id="btn-save-password"
        class="px-5 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-orange-500 text-white font-medium text-sm shadow-sm transition-all flex items-center gap-2 cursor-pointer"
        type="submit"
        disabled
      >
        <span class="material-symbols-outlined text-[18px]"
          >enhanced_encryption</span
        >
        <span>Actualizar Contraseña</span>
      </button>
    </div>
  </form>
</section>

<script>
  // Toggle visibility
  document.querySelectorAll(".toggle-password").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");
      const input = document.getElementById(targetId!) as HTMLInputElement;
      const icon = btn.querySelector(".material-symbols-outlined");
      if (input && icon) {
        if (input.type === "password") {
          input.type = "text";
          icon.textContent = "visibility_off";
        } else {
          input.type = "password";
          icon.textContent = "visibility";
        }
      }
    });
  });

  // Elementos
  const currentPass = document.getElementById(
    "current-password",
  ) as HTMLInputElement;
  const newPass = document.getElementById("new-password") as HTMLInputElement;
  const confirmPass = document.getElementById(
    "confirm-new-password",
  ) as HTMLInputElement;
  const btnSave = document.getElementById(
    "btn-save-password",
  ) as HTMLButtonElement;

  const currentPassError = document.getElementById("current-password-error");
  const newPassError = document.getElementById("new-password-error");
  const confirmPassError = document.getElementById("confirm-password-error");

  const label = document.getElementById("strength-label");
  const bar1 = document.getElementById("bar-1");
  const bar2 = document.getElementById("bar-2");
  const bar3 = document.getElementById("bar-3");

  const reqLength = document.getElementById("req-length");
  const reqUpper = document.getElementById("req-upper");
  const reqNumber = document.getElementById("req-number");
  const reqSpecial = document.getElementById("req-special");

  // Funciones de ayuda para errores de input
  const showError = (
    input: HTMLInputElement,
    errorSpan: HTMLElement | null,
    msg: string,
  ) => {
    input.classList.add(
      "border-rose-500",
      "focus:ring-rose-500/20",
      "focus:border-rose-500",
    );
    input.classList.remove(
      "border-zinc-200",
      "focus:ring-orange-500/20",
      "focus:border-orange-500",
    );
    if (errorSpan) {
      errorSpan.textContent = msg;
      errorSpan.classList.remove("hidden");
    }
  };

  const clearError = (
    input: HTMLInputElement,
    errorSpan: HTMLElement | null,
  ) => {
    input.classList.remove(
      "border-rose-500",
      "focus:ring-rose-500/20",
      "focus:border-rose-500",
    );
    input.classList.add(
      "border-zinc-200",
      "focus:ring-orange-500/20",
      "focus:border-orange-500",
    );
    if (errorSpan) {
      errorSpan.classList.add("hidden");
    }
  };

  // Helper para items de requisitos
  const updateRequirement = (el: HTMLElement | null, isValid: boolean) => {
    if (!el) return;
    const icon = el.querySelector(".material-symbols-outlined");
    if (isValid) {
      el.className = "flex items-center gap-1 text-emerald-600 font-medium";
      if (icon) icon.textContent = "check";
    } else {
      el.className = "flex items-center gap-1 text-zinc-400";
      if (icon) icon.textContent = "circle";
    }
  };

  // Validación y Estado en tiempo real
  const validateLive = () => {
    const valCurrent = currentPass.value;
    const valNew = newPass.value;
    const valConfirm = confirmPass.value;

    let isCurrentValid = false;
    let isNewValid = false;
    let isConfirmValid = false;

    // 1. Validar Contraseña Actual
    if (!valCurrent) {
      clearError(currentPass, currentPassError);
    } else {
      clearError(currentPass, currentPassError);
      isCurrentValid = true;
    }

    // 2. Evaluar Requisitos e Indicadores de Fortaleza
    const hasLength = valNew.length >= 8;
    const hasUpper = /[A-Z]/.test(valNew);
    const hasNumber = /[0-9]/.test(valNew);
    const hasSpecial = /[^A-Za-z0-9]/.test(valNew);

    updateRequirement(reqLength, hasLength);
    updateRequirement(reqUpper, hasUpper);
    updateRequirement(reqNumber, hasNumber);
    updateRequirement(reqSpecial, hasSpecial);

    const score = [hasLength, hasUpper, hasNumber, hasSpecial].filter(
      Boolean,
    ).length;

    // Actualizar barras de fortaleza
    if (!valNew) {
      if (label) {
        label.textContent = "Sin ingresar";
        label.className = "font-bold text-zinc-400";
      }
      bar1?.setAttribute("class", "h-full w-1/3 bg-zinc-300 transition-colors");
      bar2?.setAttribute("class", "h-full w-1/3 bg-zinc-300 transition-colors");
      bar3?.setAttribute("class", "h-full w-1/3 bg-zinc-300 transition-colors");
      clearError(newPass, newPassError);
    } else {
      if (score <= 2) {
        if (label) {
          label.textContent = "Débil";
          label.className = "font-bold text-rose-500";
        }
        bar1?.setAttribute(
          "class",
          "h-full w-1/3 bg-rose-500 transition-colors",
        );
        bar2?.setAttribute(
          "class",
          "h-full w-1/3 bg-zinc-300 transition-colors",
        );
        bar3?.setAttribute(
          "class",
          "h-full w-1/3 bg-zinc-300 transition-colors",
        );
      } else if (score === 3) {
        if (label) {
          label.textContent = "Aceptable";
          label.className = "font-bold text-amber-500";
        }
        bar1?.setAttribute(
          "class",
          "h-full w-1/3 bg-amber-500 transition-colors",
        );
        bar2?.setAttribute(
          "class",
          "h-full w-1/3 bg-amber-500 transition-colors",
        );
        bar3?.setAttribute(
          "class",
          "h-full w-1/3 bg-zinc-300 transition-colors",
        );
      } else {
        if (label) {
          label.textContent = "Súper Segura";
          label.className = "font-bold text-emerald-600";
        }
        bar1?.setAttribute(
          "class",
          "h-full w-1/3 bg-emerald-500 transition-colors",
        );
        bar2?.setAttribute(
          "class",
          "h-full w-1/3 bg-emerald-500 transition-colors",
        );
        bar3?.setAttribute(
          "class",
          "h-full w-1/3 bg-emerald-500 transition-colors",
        );
      }

      // Mensajes de error específicos para nueva contraseña
      if (valCurrent && valNew === valCurrent) {
        showError(
          newPass,
          newPassError,
          "La nueva contraseña no puede ser igual a la actual",
        );
      } else if (score < 4) {
        showError(
          newPass,
          newPassError,
          "Debe cumplir todos los requisitos de la lista",
        );
      } else {
        clearError(newPass, newPassError);
        isNewValid = true;
      }
    }

    // 3. Validar Confirmación
    if (!valConfirm) {
      clearError(confirmPass, confirmPassError);
    } else if (valConfirm !== valNew) {
      showError(confirmPass, confirmPassError, "Las contraseñas no coinciden");
    } else {
      clearError(confirmPass, confirmPassError);
      isConfirmValid = true;
    }

    // 4. Activar / Desactivar Botón
    if (isCurrentValid && isNewValid && isConfirmValid) {
      btnSave.removeAttribute("disabled");
    } else {
      btnSave.setAttribute("disabled", "true");
    }
  };

  // Escuchar escritura
  currentPass?.addEventListener("input", validateLive);
  newPass?.addEventListener("input", validateLive);
  confirmPass?.addEventListener("input", validateLive);

  // Submit
  const passForm = document.getElementById("password-form");
  passForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (btnSave.hasAttribute("disabled")) return;

    (window as any).showToast?.("Contraseña modificada exitosamente");
    (passForm as HTMLFormElement).reset();
    validateLive(); // Resetea barras y vuelve a bloquear el botón
  });
</script>
